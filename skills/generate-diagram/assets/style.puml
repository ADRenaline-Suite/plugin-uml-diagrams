' Presentation for every diagram.
' Source: OMG UML 2.5.1, clause 6.4.1.
' Diagrams are read as black on white.
' black = solid, white = unfilled, gray = a tone between the two.
' A fill that does not repeat a written mark is not notation.
' The face, the sizes, the spacing, and the gray hex are choices of this plugin.
' They are not values in the specification.
' Gray is not applied here. references/style.md says when #8A8A8A may be used.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam handwritten false
skinparam roundCorner 0
skinparam dpi 120
skinparam padding 8
skinparam nodesep 40
skinparam ranksep 40
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam defaultFontColor #000000
skinparam titleFontName SansSerif
skinparam titleFontSize 14
skinparam titleFontColor #000000
skinparam ArrowColor #000000
skinparam ArrowFontName SansSerif
skinparam ArrowFontColor #000000
skinparam ArrowThickness 1
skinparam classAttributeIconSize 0
hide circle

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  FontName SansSerif
  HeaderBackgroundColor #FFFFFF
  StereotypeFontColor #000000
  AttributeFontColor #000000
  BorderThickness 1
}
